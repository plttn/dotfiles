[tools]
node = "24"
go = "latest"
usage = "latest"
python = "latest"
pnpm = "11"
rust = "latest"
golangci-lint = "2.15.0"
"cargo:jj-gh" = "latest"
"cargo:cargo-binstall" = "latest"
"cargo:oyui" = "latest"
{{- if not .is_work }}
"pipx:rendercv" = { version = "latest", extras = "full" }
zig = "0.15.2"
{{- end }}

[settings]
experimental = true
idiomatic_version_file_enable_tools = ["rust"]
self_update.auto = true
go_set_goroot = false
go_set_gobin = false
